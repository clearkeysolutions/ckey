// The C ABI (include/ckey/ckey.h, used in place) as one Clang module. Swift
// imports it as `import CKeyCodec`. The scan, render and certify targets add
// only object code: their functions are declared here and linked by them.
// ckey/ckey.h in this directory is a forwarder that lets the core's
// translation units resolve "ckey/ckey.h" through this include directory.
module CKeyCodec {
    header "../../../../../include/ckey/ckey.h"
    textual header "ckey/ckey.h"
    export *
}
