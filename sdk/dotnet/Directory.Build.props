<Project>
  <!-- Shared settings for every project under sdk/dotnet. The version is the
       repository's VERSION file (e.g. 0.1.0-build.63), so the package, the
       assembly metadata and the telemetry sdk_version always agree. -->
  <PropertyGroup>
    <CKeyRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</CKeyRepoRoot>
    <CKeyVersion>$([System.IO.File]::ReadAllText('$(CKeyRepoRoot)VERSION').Trim())</CKeyVersion>
    <CKeyVersionPrefix>$([System.Text.RegularExpressions.Regex]::Match('$(CKeyVersion)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</CKeyVersionPrefix>
    <CKeyBuildNumber>$([System.Text.RegularExpressions.Regex]::Match('$(CKeyVersion)', '[0-9]+$').Value)</CKeyBuildNumber>
    <Version>$(CKeyVersion)</Version>
    <PackageVersion>$(CKeyVersion)</PackageVersion>
    <AssemblyVersion>$(CKeyVersionPrefix).0</AssemblyVersion>
    <FileVersion>$(CKeyVersionPrefix).$(CKeyBuildNumber)</FileVersion>
    <InformationalVersion>$(CKeyVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <Authors>CKey contributors</Authors>
    <Company>openckey.org</Company>
    <Copyright>Copyright (c) CKey contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/clearkeysolutions/ckey</PackageProjectUrl>
    <RepositoryUrl>https://github.com/clearkeysolutions/ckey</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ckey;2d-code;barcode;qr;scanner;optical-code</PackageTags>

    <!-- Native libraries built by sdk/dotnet/native land here as <rid>/<file>. -->
    <CKeyNativeRoot>$(MSBuildThisFileDirectory)artifacts/native/</CKeyNativeRoot>
  </PropertyGroup>
</Project>
