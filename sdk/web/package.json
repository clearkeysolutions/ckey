{
  "name": "openckey",
  "version": "0.1.0-build.84",
  "description": "CKey optical codes for the web: encode, render (canvas, pixels, PNG, SVG, PDF) and scan, with the CKey C core compiled to WebAssembly.",
  "license": "MIT",
  "homepage": "https://openckey.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearkeysolutions/ckey.git",
    "directory": "sdk/web"
  },
  "keywords": ["ckey", "optical-code", "barcode", "qr", "scanner", "webassembly", "wasm", "canvas"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/ckey.mjs",
  "module": "./dist/ckey.mjs",
  "types": "./dist/ckey.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ckey.d.ts",
      "import": "./dist/ckey.mjs",
      "default": "./dist/ckey.mjs"
    },
    "./ckey.wasm": "./dist/ckey.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "assemble": "node scripts/assemble.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:native": "bash scripts/test-native.sh",
    "prepack": "node scripts/check.mjs --dist"
  }
}
