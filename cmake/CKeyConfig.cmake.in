@PACKAGE_INIT@
# CKey CMake package. Targets:
#   CKey::codec  CKey::scan  CKey::render  CKey::certify  CKey::core  [CKey::telemetry]
# A scan-only consumer links CKey::scan alone.
set(CKEY_SOFTWARE_VERSION "@CKEY_VERSION_STRING@")
include(CMakeFindDependencyMacro)
if(@CKEY_BUILD_TELEMETRY@)
  find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CKeyTargets.cmake")
check_required_components(CKey)
